# Configuration of the hardware tests (make test-hardware). Copy to .env (git-ignored) and adapt.
# Environment variables with the same names take precedence.

# Serial port of the EnOcean USB stick (macOS: /dev/cu.usbserial-*, Linux: /dev/ttyUSB0)
ENOCEAN_PORT=/dev/cu.usbserial-XXXXXXXX

# Interactive test: a wall switch (F6-02-02) paired with a light actuator (D2-01-12)
ENOCEAN_TEST_SWITCH=00:37:7E:06
ENOCEAN_TEST_LIGHT=05:99:77:AF
ENOCEAN_TEST_LIGHT_CHANNEL=1

# Seconds to wait for each user action, and for the passive listening test
ENOCEAN_TEST_TIMEOUT=30
ENOCEAN_TEST_LISTEN_SECONDS=15
